# Holder-town settings (token, key and treasury are set in /memex; everything else is optional)
TOWN_NAME="Night Market"
TICKER=$LAMP
# engine API port and live (multiplayer) server port
PORT=5371
LIVE_PORT=5372
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Every time the fee escrow reaches ROUND_ETH, one round does all three at once: it buys the token
# once with the burn + reward parts, burns the burn part (0x…dEaD), shares the reward part with
# the top 10 by balance, and sends the treasury part (ETH) to the treasury. Percentages add up to 100.
ROUND_ETH=0.02
BURN_PCT=30
REWARD_PCT=35
TREASURY_PCT=35
REWARD_TOP_N=10
# minutes a wallet must have held to take part in a reward
MIN_HOLD_MINUTES=10
# A wallet needs this many whole tokens to live in town (a citizen with a home)
MIN_BALANCE=100000
CONTRACTS_ARE_SELLS=1
# extra sell destinations, comma separated (e.g. the Uniswap v4 PoolManager after graduation)
SELL_SINKS=
# needed for every save in /memex; generated by scripts/install-server.sh
ADMIN_SECRET=
SITE_URL=https://your-domain.example
# How often the engine reads new blocks (seconds)
POLL_INTERVAL_SECONDS=3
